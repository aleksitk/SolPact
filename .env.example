# SolPact environment (Devnet only) — copy to .env and fill in as needed.

# Optional: override the Devnet RPC endpoint.
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional: override the demo vault address that receives staked SOL.
# VITE_VAULT_ADDRESS=FPPxf4dtUhPdrAkZHBTDvppkMREFVJ8FFtBDoc7moPEq

# DEMO ONLY (Devnet): vault keypair secret as a JSON array of bytes, used by
# the client to sign the claim (vault -> user) transfer in Phase 5.
# This is the array stored in the local, gitignored vault-devnet.key.json.
# NEVER use a real wallet or mainnet funds here. Leave unset to disable claims.
# VITE_VAULT_SECRET_KEY=[12,34,...]
